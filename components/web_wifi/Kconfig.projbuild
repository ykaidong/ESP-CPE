menu "4G Modem WiFi Config"

    config SERVER_IP
        string "WiFi AP IP Address"
        default "192.168.4.1"
        help
            IPv4 address assigned to the SoftAP interface. The SoftAP SSID,
            password, channel, bandwidth and maximum station count are
            generated/validated at runtime by components/cpe_core (see the
            "CPE Core Configuration" menu); no fixed credential is compiled in.

    config ESP_MAXIMUM_RETRY
        int "Maximum station reconnect attempts"
        default 5
        range 1 20
        help
            Only used when an optional upstream STA SSID is configured through
            cpe_config. The product WAN is the USB ECM link.

    config EXAMPLE_WEB_MOUNT_POINT
        string "Website mount point in VFS"
        default "/spiffs"
        help
            Specify the mount point in VFS.

endmenu
