# ESP-CPE product base - minimal default configuration.
# Regenerate sdkconfig with:  idf.py set-target esp32s3 && idf.py build
# NOTE: sdkconfig is intentionally NOT tracked in git; put every required
#       non-default value here.

# ---- Flash: 16MB, QIO at 80MHz -------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- Partition table: dual OTA + storage --------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16m_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y

# ---- FreeRTOS / logging --------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_COLORS=y

# ---- PSRAM: 8MB octal on the S3 R8 module -------------------------------
# Internal RAM alone cannot hold the MQTT TLS session (~49 KB) next to a full
# page load (four httpd connections: 8 KB stack + up to 16 KB TCP send buffer
# each), which exhausted the heap and stalled every transfer. With malloc()
# backed by PSRAM, allocations above SPIRAM_MALLOC_ALWAYSINTERNAL (the 16 KB
# TLS input buffer) move out of internal RAM; the USB and Wi-Fi DMA buffers
# stay internal because they are smaller than that threshold.
# IGNORE_NOTFOUND keeps a mis-sized module (e.g. 2MB quad) bootable: the
# firmware then runs with internal RAM only instead of panicking.
# 80MHz is the rated speed of the octal chip; if the memory test becomes
# unstable, falling back to 40MHz is the first thing to try.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- Wi-Fi buffers (CPE AP with several clients) ------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_GMAC_SUPPORT=n

# ---- lwIP: forwarding + NAPT for the CPE --------------------------------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_IPV6=n
# Forwarded traffic is NAPT at the IP layer and never touches these windows;
# they only bound connections the device itself opens (console, MQTT, OTA).
# lwIP allocates pbufs from the system heap, so 64 KB per connection was the
# main reason an ECM receive packet could not get 1360 bytes.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
# Sockets are shared by the console, SNTP and the MQTT client. The IDF default
# of 10 is exactly the worst case (1 listening + 7 accepted + 1 SNTP + 1 MQTT),
# so a browser holding its connections makes the MQTT socket() fail.
CONFIG_LWIP_MAX_SOCKETS=16

# ---- mbedTLS (firmware size) -------------------------------------------
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# ---- USB Host ------------------------------------------------------------
# The enumeration filter is dangerous for generic ECM modules: it forces a
# configuration number on every USB device. Disabled by default; enable and
# configure VID/PID only for known modules that need a specific config value
# (see CPE_* Kconfig options in main/Kconfig.projbuild).
# CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK is not set
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512

# ---- Crash behaviour -----------------------------------------------------
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ---- SoftAP DHCP server ---------------------------------------------------
# The lease table must hold at least as many clients as the SoftAP can accept
# (CPE_MAX_STA_MAX = 10). With the IDF default of 8 the server silently deletes
# the oldest lease when the list is full (dhcpserver.c: kill_oldest_dhcps_pool)
# and then hands that IP to a new station while the old one still uses it, which
# shows up as two clients with the same address.
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16
# Keep the client hostname (DHCP option 12) so the console can show it.
CONFIG_LWIP_DHCPS_REPORT_CLIENT_HOSTNAME=y

# ---- Periodic maintenance (see main/Kconfig.projbuild) --------------------
# Disabled by default: no periodic ECM rebuild and no periodic reboot until it
# is enabled from the management console ("定时维护" on the status page), which
# stores the periods in NVS. These Kconfig values are only the defaults used on
# first boot / after a factory reset; set them to a number of minutes to have a
# schedule out of the box.
CONFIG_CPE_MAINT_ECM_PERIOD_MIN=0
CONFIG_CPE_MAINT_REBOOT_PERIOD_MIN=0
CONFIG_CPE_MAINT_RESET_MODEM=y
CONFIG_CPE_MAINT_MAX_SCHED_REBOOTS=3

# ---- OTA rollback (Phase 3) ---------------------------------------------
# An OTA image boots in PENDING_VERIFY and is rolled back unless the firmware
# marks it valid (cpe_ota.c, after CPE_OTA_VALIDATE_DELAY_MS). Direct
# `idf.py flash` writes are unaffected by this option.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
