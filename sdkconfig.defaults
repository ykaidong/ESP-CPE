# ESP-CPE product base - minimal default configuration.
# Regenerate sdkconfig with:  idf.py set-target esp32s3 && idf.py build
# NOTE: sdkconfig is intentionally NOT tracked in git; put every required
#       non-default value here.

# ---- Flash: 16MB, QIO at 80MHz -------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- Partition table: dual OTA + storage --------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16m_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y

# ---- FreeRTOS / logging --------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_COLORS=y

# ---- Wi-Fi buffers (CPE AP with several clients) ------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_GMAC_SUPPORT=n

# ---- lwIP: forwarding + NAPT for the CPE --------------------------------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# ---- mbedTLS (firmware size) -------------------------------------------
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# ---- USB Host ------------------------------------------------------------
# The enumeration filter is dangerous for generic ECM modules: it forces a
# configuration number on every USB device. Disabled by default; enable and
# configure VID/PID only for known modules that need a specific config value
# (see CPE_* Kconfig options in main/Kconfig.projbuild).
# CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK is not set
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512

# ---- Crash behaviour -----------------------------------------------------
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ---- Periodic maintenance (see main/Kconfig.projbuild) --------------------
# Disabled by default: no periodic ECM rebuild and no periodic reboot until it
# is enabled from the management console ("定时维护" on the status page), which
# stores the periods in NVS. These Kconfig values are only the defaults used on
# first boot / after a factory reset; set them to a number of minutes to have a
# schedule out of the box.
CONFIG_CPE_MAINT_ECM_PERIOD_MIN=0
CONFIG_CPE_MAINT_REBOOT_PERIOD_MIN=0
CONFIG_CPE_MAINT_RESET_MODEM=y
CONFIG_CPE_MAINT_MAX_SCHED_REBOOTS=3

# ---- OTA rollback (Phase 3) ---------------------------------------------
# An OTA image boots in PENDING_VERIFY and is rolled back unless the firmware
# marks it valid (cpe_ota.c, after CPE_OTA_VALIDATE_DELAY_MS). Direct
# `idf.py flash` writes are unaffected by this option.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
